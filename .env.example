# Optional: Feishu robot webhook. Signals are sent only when BUY/SELL appears.
FEISHU_WEBHOOK_URL="https://open.feishu.cn/open-apis/bot/v2/hook/..."

# Alternative: Feishu self-built app mode. Use this when custom webhook robots
# are disabled. Leave FEISHU_WEBHOOK_URL empty when using app mode.
FEISHU_APP_ID="cli_xxxxxxxxxxxx"
FEISHU_APP_SECRET="xxxxxxxxxxxxxxxxxxxx"
# Private chat: open_id. Group chat: chat_id.
FEISHU_RECEIVE_ID="ou_xxxxxxxxxxxx"
FEISHU_RECEIVE_ID_TYPE="open_id"
